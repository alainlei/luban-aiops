SKILLS_STORE_BACKEND=postgres
SKILLS_DB_URL=postgresql://audit:audit-dev-local@postgres:5432/skills
SKILLS_SYNC_INTERVAL_SECONDS=300
# SPEC-057 R-2 / OQ-4: composite-wide bound on a composition's sub_skills
# count. 8 × GATEWAY_BROWSER_FLOW_MAX_STEPS (20) = 160 worst-case unlocked
# browser writes per run, each still individually signed, audited, receipted
# and gated once per sub-skill.
SKILLS_COMPOSITION_MAX_SUB_SKILLS=8
SKILLS_DATA_PATH=/var/lib/skills-hub
# Federated sources (SPEC-014 R-2). `platform-skills` is a git source over the
# platform repo itself (production-parity pattern: non-secret url/ref/path
# here, the PAT only in the skills-hub-runtime-secrets Secret via
# SKILLS_GIT_TOKENS). Git 'path' selects the subdirectory within the checkout
# to ingest, and carries all of shared/platform-ops/skills — both the
# sre-alerting alerts and the platform-runbooks guides.
# Those two trees were formerly mounted a second time as local ConfigMap
# sources (`sre-alerting`, `platform-runbooks`). Because skill_id is
# source-prefixed, that registered every document twice under two ids, and
# since rank() does no content de-duplication the copies consumed result
# slots — measured at 32 of 63 recorded queries, see
# docs/workspace/semantic-skill-retrieval-eval-set.md §2.1. Removed
# 2026-10-01 along with their ConfigMap generators, volumes and mounts; the
# git source is now their sole route. A failed clone does not empty the
# store: sync_once calls replace_source only on success, so the last good
# snapshot in Postgres keeps serving while updates stop, and last_error on
# the status endpoint says so.
# The `samples` local source (SPEC-050 R-11) backs tutorial skills under
# samples/; its ConfigMap is populated out-of-band by `make deploy-samples`
# and is empty/absent by default, so it ingests nothing until a sample is
# installed. The base overlay never names a specific sample.
SKILLS_SOURCES=[{"source_id":"samples","type":"local","path":"/skills/samples"},{"source_id":"platform-skills","type":"git","url":"https://github.com/metasync/luban-aiops.git","ref":"main","path":"shared/platform-ops/skills"}]
# Query credentials arrive via the skills-hub-runtime-secrets secret
# (SKILLS_QUERY_CLIENTS), provisioned by sync-skills-secrets.sh.
# Usage audit trail (SPEC-029): emit skill_searched/skill_retrieved/
# skills_synced events to the audit-service. The ingest credential
# (SKILLS_AUDIT_CLIENT_SECRET) is provisioned by sync-audit-secrets.sh.
SKILLS_AUDIT_SERVICE_URL=http://audit-service:8000
SKILLS_AUDIT_CLIENT_ID=skills-hub
